{
  "name": "plotwake",
  "version": "0.2.0",
  "description": "A morning check for everything you ship. Self-hosted GA4 and Search Console portfolio dashboard.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir demo-dist",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview:demo": "vite preview --outDir demo-dist --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
}
