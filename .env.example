# Generate a unique password; never commit .env.
PLOTWAKE_USERNAME=admin
PLOTWAKE_PASSWORD=change-me-to-a-random-password-of-at-least-16-characters
PORT=3000
HOST=127.0.0.1
# For local use. Set this to your actual HTTPS origin behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
PLOTWAKE_DB=data/plotwake.sqlite
